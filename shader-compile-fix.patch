--- a/src/Utils/WinApi.cpp	2026-10-04 23:08:57.622163073 -0500
+++ b/src/Utils/WinApi.cpp	2026-10-04 23:09:34.066045003 -0500
@@ -1,4 +1,5 @@
 #include "WinApi.h"
+#include <cstring>
 
 namespace Util
 {
@@ -69,4 +70,26 @@
 		}();
 		return cached;
 	}
+
+	std::optional<std::string> GetWineVersion()
+	{
+		const HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+		if (!ntdll)
+			return std::nullopt;
+		using WineGetVersionFn = const char*(__cdecl*)();
+		const auto fn = reinterpret_cast<WineGetVersionFn>(GetProcAddress(ntdll, "wine_get_version"));
+		if (!fn)
+			return std::nullopt;
+		const char* version = fn();
+		return std::string(version ? version : "unknown");
+	}
+
+	bool IsWineBuiltinModule(HMODULE a_module)
+	{
+		if (!a_module)
+			return false;
+		static constexpr char kBuiltinSignature[] = "Wine builtin DLL";
+		const auto* base = reinterpret_cast<const char*>(a_module);
+		return std::memcmp(base + 0x40, kBuiltinSignature, sizeof(kBuiltinSignature) - 1) == 0;
+	}
 }  // namespace Util
